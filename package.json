{
  "name": "maip-vscode",
  "displayName": "MAIP - Machine Identity & Integrity",
  "description": "Truthlocks machine identities, signed receipts and signature verification in VS Code",
  "version": "1.4.4",
  "publisher": "truthlocks",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/truthlocks/maip-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "maip.register",
        "title": "MAIP: Register Developer",
        "icon": "$(account)"
      },
      {
        "command": "maip.registerAgent",
        "title": "MAIP: Register Agent",
        "icon": "$(person-add)"
      },
      {
        "command": "maip.createReceipt",
        "title": "MAIP: Create Receipt",
        "icon": "$(shield)"
      },
      {
        "command": "maip.verifyReceipt",
        "title": "MAIP: Verify Receipt",
        "icon": "$(verified)"
      },
      {
        "command": "maip.showTrustScore",
        "title": "MAIP: Show Trust Score",
        "icon": "$(graph)"
      },
      {
        "command": "maip.listReceipts",
        "title": "MAIP: List Receipts",
        "icon": "$(list-flat)"
      },
      {
        "command": "maip.exportAudit",
        "title": "MAIP: Export Agent Evidence",
        "icon": "$(export)"
      },
      {
        "command": "maip.refreshReceipts",
        "title": "MAIP: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "maip.configure",
        "title": "MAIP: Configure Credentials",
        "icon": "$(gear)"
      },
      {
        "command": "maip.testConnection",
        "title": "MAIP: Test Connection",
        "icon": "$(plug)"
      },
      {
        "command": "maip.signOut",
        "title": "MAIP: Sign Out",
        "icon": "$(sign-out)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maip-explorer",
          "title": "MAIP",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "maip-explorer": [
        {
          "id": "maip.agents",
          "name": "Agents"
        },
        {
          "id": "maip.receipts",
          "name": "Receipts"
        },
        {
          "id": "maip.delegations",
          "name": "Delegations"
        }
      ]
    },
    "configuration": {
      "title": "MAIP",
      "properties": {
        "maip.apiUrl": {
          "type": "string",
          "default": "https://sandbox-api.truthlocks.com/v1",
          "description": "MAIP API base URL (e.g., https://api.truthlocks.com/v1)"
        },
        "maip.apiKey": {
          "type": "string",
          "default": "",
          "description": "MAIP API Key",
          "deprecationMessage": "Run MAIP: Configure Credentials. API keys are now read only from encrypted SecretStorage, not settings."
        },
        "maip.tenantId": {
          "type": "string",
          "default": "",
          "description": "Tenant ID"
        },
        "maip.agentId": {
          "type": "string",
          "default": "",
          "description": "Agent ID for this workspace"
        },
        "maip.signingAlgorithm": {
          "type": "string",
          "default": "Ed25519",
          "enum": [
            "ES256",
            "ES384",
            "ES512",
            "RS256",
            "RS384",
            "RS512",
            "PS256",
            "PS384",
            "PS512",
            "Ed25519"
          ],
          "description": "Legacy preference recorded as requested_algorithm metadata. MAIP signs with the registered agent key; this setting does not select or change that key."
        },
        "maip.autoReceiptOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Auto-generate receipt on file save"
        },
        "maip.autoReceiptOnCommit": {
          "type": "boolean",
          "default": false,
          "description": "Auto-generate receipt on git commit"
        },
        "maip.showTrustBadges": {
          "type": "boolean",
          "default": true,
          "description": "Show inline trust score badges"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "maip.createReceipt",
          "group": "maip"
        }
      ],
      "scm/title": [
        {
          "command": "maip.createReceipt",
          "group": "maip"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "package": "vsce package",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "vscode:prepublish": "node scripts/check-package.cjs && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4",
    "vitest": "^1.0",
    "@vscode/vsce": "^2.0",
    "@types/node": "^20.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "MAIP can submit workspace receipt metadata. Trust the workspace before enabling the extension."
    },
    "virtualWorkspaces": false
  }
}
